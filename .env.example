# Copy to .env and fill in. Never commit the real .env.

# Supabase — from your project's Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Admin page password (single shared password gating the leaderboard export).
# Client-checked for the event's scale; see README "Security notes".
VITE_ADMIN_PASSWORD=change-me

# Optional: force a specific event day for testing (mon|tue|wed|thu|fri).
# Leave unset in production so the site auto-switches by Eastern Time.
# VITE_FORCE_DAY=wed
